{
	"image": "registry.simbricks.io/internal/conda-docker-image/conda-build-env:latest",
	"runArgs": [
		"--device=/dev/kvm"
	],
	"postStartCommand": "sudo chmod 666 /dev/kvm || true",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-vscode.cpptools"
			]
		}
	},
	"remoteUser": "simbricks"
}
